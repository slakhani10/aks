# Copy to terraform.tfvars for local runs. The GitHub workflow passes these as TF_VAR_* instead.
resource_group_name = "rg-shop-prod" # must already exist

system_node_vm_size = "Standard_D4ds_v5"
system_node_count   = 3
user_node_vm_size   = "Standard_D4ds_v5"
user_node_count     = 2

# Network ranges (subnets incl. the App Gateway for Containers /24 are derived automatically)
aks_vnet_cidr = "10.0.0.0/22"   # /16 - /22
pod_cidr      = "10.244.0.0/16" # /12 - /20, overlay only
service_cidr  = "172.16.0.0/16" # /12 - /24

# Optional
# aks_admin_group_object_ids     = ["00000000-0000-0000-0000-000000000000"]
# enable_vnet_flow_logs          = true
# additional_tags                = { owner = "platform-team" } # resource group tags are always copied
