#cloud-config
# Prepares the VM as a GitHub Actions self-hosted runner. Registration with GitHub
# is NOT done here: the deploy-runner workflow registers the runner afterwards via
# `az vm run-command`, so the registration token never lands in Terraform state.
package_update: true
package_upgrade: true
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gettext-base # envsubst, used by the AKS workflow
  - git
  - gnupg
  - jq
  - lsb-release
  - python3
  - unzip # hashicorp/setup-terraform

users:
  - default
  - name: runner
    gecos: GitHub Actions runner
    shell: /bin/bash
    lock_passwd: true

write_files:
  - path: /opt/setup-runner.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      VERSION="${runner_version}"
      if [ -z "$VERSION" ] || [ "$VERSION" = "latest" ]; then
        VERSION=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | jq -r .tag_name)
      fi
      VERSION="$${VERSION#v}"
      mkdir -p /opt/actions-runner
      cd /opt/actions-runner
      if [ ! -x ./config.sh ]; then
        curl -fsSL -o runner.tgz "https://github.com/actions/runner/releases/download/v$${VERSION}/actions-runner-linux-x64-$${VERSION}.tar.gz"
        tar xzf runner.tgz
        rm -f runner.tgz
        ./bin/installdependencies.sh
      fi
      chown -R runner:runner /opt/actions-runner
      echo "GitHub Actions runner $${VERSION} staged in /opt/actions-runner"

runcmd:
  # Azure CLI from Microsoft's apt repository (used by azure/login and the workflows)
  - [bash, -c, "curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash"]
  - [bash, /opt/setup-runner.sh]
